{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Checklist",
  "version": "0.1.15",
  "identifier": "io.benjatator.todolist",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "todolist",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMUJDQzdCQTBEMTY2QTEKUldTaFp0R2dlOHdiWHNZQmR4b21oS1MyWW1ndmMrL2g1c2ljMU1aYUlOTlpzS0ZQaklxcFRxaU0K",
      "endpoints": [
        "https://github.com/BWIL107/toDoList/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
